{
  "name": "cutmate-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @cutmate/web --filter @cutmate/api dev",
    "desktop:build": "tauri build --bundles dmg",
    "desktop:dev": "tauri dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:desktop-config && pnpm test:desktop-workflow && pnpm -r test",
    "test:desktop-config": "node scripts/verify-tauri-config.mjs",
    "test:desktop-workflow": "node scripts/verify-macos-workflow.mjs",
    "build": "pnpm -r build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
